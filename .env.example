# Qost Twin — переменные окружения (SPEC §4.6). Скопировать в .env и поменять секреты.
PLANT_CONFIG_DIR=/app/config
DATABASE_URL=postgresql+asyncpg://qost:qost@timescaledb:5432/qost
POSTGRES_USER=qost
POSTGRES_PASSWORD=qost
POSTGRES_DB=qost
REDIS_URL=redis://redis:6379/0
MQTT_URL=mqtt://mqtt:1883
OPCUA_ENDPOINT=opc.tcp://sim:4840/qost/
CLOCK_MODE=sim
# virtual plant: start the plant clock right after warm-up (false: paused at demo_start)
SIM_AUTOSTART=true
# collector (SPEC §7): states/telemetry from OPC UA, unit/defect events from the MQTT UNS
COLLECTOR_SIGNALS=opcua
COLLECTOR_UNITS=mqtt
EVENTS_STREAM_MAXLEN=300000
# engine (SPEC §9): history alerts written resolved by `qost_engine replay` (resolved | open)
ENGINE_REPLAY_ALERTS=resolved
OFFLINE=true
JWT_SECRET=change-me
JWT_TTL_HOURS=12
DEMO_PASSWORD=qost2026
LLM_PROVIDER=none
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OLLAMA_URL=http://host.docker.internal:11434
# LLM tuning (M8): hard timeout per call, effort of the anthropic model, server-side fallback on refusal
LLM_TIMEOUT_S=20
LLM_EFFORT=low
LLM_FALLBACKS=default
TELEGRAM_BOT_TOKEN=
TELEGRAM_ROLE_PINS=director:1111,master:2222,maintenance:3333,quality:4444
PUBLIC_WEB_URL=http://localhost:3000
# notifier (M8): service account of the «Принять» button (a seeded demo user; password = DEMO_PASSWORD
# unless NOTIFIER_API_PASSWORD is set); Telegram rejects localhost URL buttons — the link then goes into the text
NOTIFIER_API_USER=admin
NOTIFIER_API_PASSWORD=
